# =============================================================
# WireGuard + Sidecar — Environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================

# ------------------------------------------------------------------
# System
# ------------------------------------------------------------------
TZ=Europe/Madrid
PUID=1000
PGID=1000

# ------------------------------------------------------------------
# WireGuard server
# ------------------------------------------------------------------

# Public IP or domain clients will connect to.
# Use "auto" to let the container detect the public IP automatically.
SERVERURL=auto

# UDP port WireGuard listens on. Must be open in the firewall.
SERVERPORT=51820

# Internal VPN subnet. .0 (network), .1 (server) and .255 (broadcast) are reserved.
# Must match the subnet configured in the Anchor WireGuard integration.
INTERNAL_SUBNET=10.13.13.0

# Comma-separated peer names (or a number) for the initial static config.
# Dynamic peers are managed via the sidecar API — this only seeds the first boot.
PEERS=peer1

# DNS pushed to VPN clients.
PEERDNS=auto

# Which traffic goes through the VPN (0.0.0.0/0 = full tunnel).
ALLOWEDIPS=0.0.0.0/0,::/0

# ------------------------------------------------------------------
# Sidecar API
# ------------------------------------------------------------------

# API key the Anchor server uses to authenticate against the sidecar.
# Must match the api_key saved in the Anchor WireGuard integration config.
# Generate: openssl rand -base64 32
WG_API_KEY=dev-only-api-key-change-in-production

# Host port the sidecar listens on (bound to the wireguard container).
# anc-server (separate stack) reaches it via http://host.docker.internal:8000
# — configure that URL as sidecar_url when saving the WireGuard integration in Anchor.
# Restrict this port in your firewall — it must NOT be publicly reachable.
WG_SIDECAR_PORT=8000
