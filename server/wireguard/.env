# ===========================================
# WireGuard Docker - Environment Configuration
# ===========================================

TZ=Europe/Madrid
PUID=1000
PGID=1000

# Server public URL — pon tu IP o dominio aquí
SERVERURL=46.225.214.144

# Puerto WireGuard
SERVERPORT=51820

# Subred interna de la VPN
INTERNAL_SUBNET=10.13.13.0

# Peers a generar (nombres separados por comas, o un número)
# IMPORTANTE: esta variable DEBE estar definida para modo servidor
PEERS=peer1

# DNS para los peers
PEERDNS=auto

# IPs permitidas (0.0.0.0/0 = todo el tráfico por VPN)
ALLOWEDIPS=0.0.0.0/0,::/0

# ===========================================
# WireGuard Sidecar API
# ===========================================

# API Key para autenticar peticiones al sidecar (header X-API-Key)
# Genera una clave segura: openssl rand -base64 32
WG_API_KEY=changeme-generate-a-strong-key

# Puerto del sidecar (expuesto por el contenedor wireguard)
WG_SIDECAR_PORT=8000
