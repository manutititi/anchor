# =============================================================
# Anchor — Environment variables for the merged docker-compose.yml
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================

# ------------------------------------------------------------------
# System
# ------------------------------------------------------------------
TZ=Europe/Madrid
PUID=1000
PGID=1000

# ------------------------------------------------------------------
# WireGuard server
# ------------------------------------------------------------------

# Public IP or domain that VPN clients connect to.
# Use "auto" to let the container detect it automatically.
SERVERURL=auto

# UDP port WireGuard listens on. Must be open in the firewall.
SERVERPORT=51820

# Internal VPN subnet. .0 (network), .1 (server) and .255 (broadcast) are reserved.
# Must match the subnet configured in the Anchor WireGuard integration.
INTERNAL_SUBNET=10.13.13.0

# Comma-separated peer names (or a number) for the initial static config.
# Dynamic peers are managed via the sidecar API — this only seeds the first boot.
PEERS=peer1

# DNS pushed to VPN clients.
PEERDNS=auto

# Which traffic goes through the VPN (0.0.0.0/0 = full tunnel).
ALLOWEDIPS=0.0.0.0/0,::/0

# ------------------------------------------------------------------
# Sidecar API key
# API key the Anchor server uses to authenticate against the WireGuard sidecar.
# Must match the api_key saved in the Anchor WireGuard integration config.
# Generate: openssl rand -base64 32
# ------------------------------------------------------------------
WG_API_KEY=dev-only-api-key-change-in-production

# ------------------------------------------------------------------
# JWT signing secret — any random string, min 32 chars recommended.
# Generate: openssl rand -base64 32
# ------------------------------------------------------------------
JWT_SECRET=dGhpcy1pcy1hLXRlc3Qtb25seS1rZXktY2hhbmdlLW1lIQ==

# ------------------------------------------------------------------
# Vault master key — used with HKDF to derive per-secret AES keys.
# Must be valid base64. CHANGING THIS INVALIDATES ALL STORED SECRETS.
# Generate: openssl rand -base64 32
# ------------------------------------------------------------------
VAULT_MASTER_KEY=dGhpcy1pcy1hLXRlc3Qtb25seS1rZXktY2hhbmdlLW1lIQ==

# ------------------------------------------------------------------
# SPA V2 — X25519 keypair for ECDH-based UDP knock encryption.
# Clients encrypt knock packets with SPA_PUBKEY; the server decrypts
# with SPA_PRIVKEY.  No shared secrets are stored on the client.
# Generate both with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey; \
#     import base64; k=X25519PrivateKey.generate(); \
#     print('SPA_PRIVKEY=' + base64.b64encode(k.private_bytes_raw()).decode()); \
#     print('SPA_PUBKEY=' + base64.b64encode(k.public_key().public_bytes_raw()).decode())"
# ------------------------------------------------------------------
SPA_PRIVKEY=
SPA_PUBKEY=
