# =============================================================
# Anchor Server — Environment variables
#
# Quick start:  ./start.sh   (interactive wizard generates .env)
# Manual setup: cp .env.example .env  &&  edit values below
#
# NEVER commit .env to version control.
# =============================================================

# ── General ───────────────────────────────────────────────────
TZ=UTC
PUID=1000
PGID=1000

# ── Network & VPN ─────────────────────────────────────────────

# Public IP or domain that VPN clients connect to.
# Use "auto" to let the container detect it via external service.
SERVERURL=auto

# UDP port WireGuard listens on. Must be open in firewall.
SERVERPORT=51820

# Internal VPN subnet. Reserved: .0 (network), .1 (server),
# .2 (static admin peer), .255 (broadcast). Users start at .3+.
INTERNAL_SUBNET=10.13.13.0

# SPA knock port (UDP). Must be open in firewall.
KNOCK_PORT=62201

# DNS pushed to VPN clients (empty = none).
PEERDNS=

# Traffic routed through VPN (server only by default, 0.0.0.0/0 = full tunnel).
ALLOWEDIPS=10.13.13.1/32

# Static admin peer names (comma-separated).
PEERS=peer1

# ── MongoDB ───────────────────────────────────────────────────
# Internal-only — not exposed outside Docker network.
MONGO_USER=ancadmin
MONGO_PASS=ancpass
MONGO_DB=anchor

# ── Secrets ───────────────────────────────────────────────────
# Generate all with:  openssl rand -base64 32

# JWT signing key (min 32 chars).
JWT_SECRET=

# Vault master key — AES-256 via HKDF. CHANGING THIS INVALIDATES ALL SECRETS.
VAULT_MASTER_KEY=

# API key for anc-server <-> wg-sidecar auth.
WG_API_KEY=

# X25519 private key for SPA v2 ECIES (base64).
# Generate: openssl genpkey -algorithm X25519 | openssl pkey -outform DER | tail -c 32 | base64
SPA_PRIVKEY_B64=
