# =============================================================
# Anchor Server — Environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================

# ------------------------------------------------------------------
# JWT signing secret — any random string, min 32 chars recommended.
# Generate: openssl rand -base64 32
# ------------------------------------------------------------------
JWT_SECRET=dGhpcy1pcy1hLXRlc3Qtb25seS1rZXktY2hhbmdlLW1lIQ==

# ------------------------------------------------------------------
# Vault master key — used with HKDF to derive per-secret AES keys.
# Must be valid base64. CHANGING THIS INVALIDATES ALL STORED SECRETS.
# Generate: openssl rand -base64 32
# ------------------------------------------------------------------
VAULT_MASTER_KEY=dGhpcy1pcy1hLXRlc3Qtb25seS1rZXktY2hhbmdlLW1lIQ==
